  "reviewed_contracts": [
    {
      "area": "explicit wipe export",
      "finding": "Export runs under retained update/install/control leases before remove_plugin or selected deletion. Home-relative normalized selection, no-follow source descriptors, owned regular single-link source guards, metadata-only approved aliases and exact per-member/digest verification are preserved. Exclusive same-directory link publication follows file fsync, then directory fsync and final inode/content checks. Fresh idle and selection/export identities gate first and later destructive boundaries. Normal/reset/legacy scopes are separate.",
      "tests": "20 focused export cases plus35 retained removal cases; current772 application-python passed289 tests with2 wrapper-only skips.",
      "limits": [
        "Private TAR is not encrypted and intentionally retains credentials; archive path/hash metadata only is returned.",
        "Recovery stages selected regular files manually and reinstalls a separately verified application; no automatic restore/application rollback is asserted.",
        "120-second budget is cooperative and does not guarantee hard wall-clock termination of blocked I/O.",
        "OS/same-user administrator compromise and sudden power failure are not fixture-proven; actual Deck loader/recovery remains unrun."
      ]
    },
    {
      "area": "public history pagination",
      "finding": "Exact public canonical metadata binds positive integer repository ID before alias use. Only same-ID/same-endpoint numeric aliases normalize to canonical requests; original filters, next sequential page and one bounded demonstrated opaque cursor are retained. Credentials/authority/fragment/control/redirect/query confusion fail closed. Existing page/request/byte bounds and auth-free public capture remain.",
      "tests": "15 focused tests including34 malicious pagination subcases; current772 tooling-python151 passed.",
      "limits": [
        "Current development capture is not an atomic retirement backup and is bound to its own remote refs.",
        "Raw verbatim public history needs byte-bound privacy review; an old example exception cannot authorize newly captured bytes."
      ]
    },
    {
      "area": "destination/service readiness",
      "finding": "Transport is exact-host GET-only, bounded and no-redirect. Existing gh authentication stays in-memory. Explicit public repo/real PR, repoIDs, exact commits/trees/blob hashes and public-head identity are verified. Conservative source policy remains separate from actual service/run/PR/job/step observations. Unique source job display plus unique source/runtime step identity prevents unrelated success substitution. Incomplete/403/404/empty data remain explicit gates.",
      "tests": "22 focused tests including duplicate/dynamic source/runtime label cases; current772 tooling-python151 passed.",
      "limits": [
        "Static workflow markers are not a full YAML/action/script audit or proof of no possible publication.",
        "Collector does not read/enable the actual Dependency Graph setting; destination owner must correlate settings/manifest ingestion.",
        "Actual final-source live collector execution remains pending; priora6 probe does not qualify new source or an unknown destination."
      ]
    },
    {
      "area": "docs/release/authentication boundaries",
      "finding": "Guide now uses Decky replacement/removal as primary, keeps optional legacy helper version/hash-sensitive and pre-wipe credentials explicit. Full existing runtime TAR is reused for cleanup preview; no second removal framework. Original230 ledger and historical469 installer remain unchanged. Proposed auth packet keeps account/registration/login/service coding unactivated; preparation does not imply release, migration, rights or human approval.",
      "tests": "Focused doc/privacy/link/projection checks recorded in source preparation; first current772 brand/frontend/browser checks passed.",
      "limits": [
        "A new concrete current772 artifact/owner packet and final full qualification are pending.",
        "Owner design selection, exact migration destination/authority, device/provider and rights/adoption decisions remain separate."
      ]
    }
  ],
